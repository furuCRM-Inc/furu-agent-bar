<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>FlashBar AI - System Administrator</label>
    <description>Provides full administrative access to FlashBar AI configuration, knowledge dictionary caches, and Claude integration settings.</description>

    <!-- FuruAgent_Knowledge__c: full CRUD + ViewAll + ModifyAll -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>FuruAgent_Knowledge__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- FlashBar_Nav_Item__c: full CRUD (admin can manage all nav items) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>FlashBar_Nav_Item__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- FlashBar_Nav_Item__c field permissions -->
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Label__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.User__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Target_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Target_SOQL_Filter__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Target_URL_Page__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Icon_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FlashBar_Nav_Item__c.Sort_Order__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- FuruAgent_Knowledge__c FLS: all fields read + edit -->
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Error_Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Last_Cached_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Occurrences__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Plain_English_Rule__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Schema_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Summary_Fields_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>FuruAgent_Knowledge__c.Trigger_Field__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Apex Class Access: all runtime + admin classes -->
    <classAccesses>
        <apexClass>FlashBarAdminController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarMassEditService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarNavigationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarOCRController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarRecentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarSchemaCacheService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarSummaryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FuruAgentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Custom Permission: enables admin-only UI features in LWC -->
    <customPermissions>
        <enabled>true</enabled>
        <name>FlashBar_Admin_Access</name>
    </customPermissions>
</PermissionSet>
