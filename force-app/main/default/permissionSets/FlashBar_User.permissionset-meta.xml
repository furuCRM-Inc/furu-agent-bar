<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>FlashBar AI - Standard User</label>
    <description>Provides access to use FlashBar AI bar for natural language search, DML operations, OCR, and recent suggestions. No write access to knowledge dictionary objects.</description>

    <!-- FuruAgent_Knowledge__c: read-only for AI cache lookups -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>FuruAgent_Knowledge__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- FlashBar_Nav_Item__c: users manage their own personal nav pins -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>FlashBar_Nav_Item__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- FuruAgent_Knowledge__c FLS: non-required fields accessed by FlashBarSummaryService / FlashBarSchemaCacheService -->
    <fieldPermissions>
        <editable>false</editable>
        <field>FuruAgent_Knowledge__c.Last_Cached_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>FuruAgent_Knowledge__c.Summary_Fields_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>FuruAgent_Knowledge__c.Schema_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>FlashBarAdminController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarAgentforceRuntime</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarMassEditService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarNavigationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarOCRController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarRecentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarSchemaCacheService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlashBarSummaryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FuruAgentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
