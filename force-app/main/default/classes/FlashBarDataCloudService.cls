/**
 * FlashBarDataCloudService
 *
 * Executes Data Cloud (Data Engine) queries and ingestion requests from the
 * FlashBar UI. Data Cloud objects (DMO / DLO) cannot use standard SOQL or
 * Apex DML — they require dedicated APIs:
 *
 *   Read : Data Cloud Query API v2
 *          POST /services/data/v61.0/ssot/queryv2
 *          Body: { "sql": "<ANSI SQL>" }
 *
 *   Write: Data Cloud Ingestion API
 *          POST /services/data/v61.0/ssot/datasets/{objectApiName}/records
 *
 * The ANSI SQL string is compiled in the Cloudflare Worker (dataCloudSqlCompiler.ts)
 * and passed here as part of the JevPayload. No SQL generation happens in Apex.
 *
 * Trust Layer:
 *   - All API calls use the running user's session (Named Credential).
 *   - No raw field values are sent to the Worker (zero customer data).
 *   - Results are returned directly to the LWC without intermediate storage.
 */
public with sharing class FlashBarDataCloudService {

    // ── Result types ──────────────────────────────────────────────────────────

    public class QueryResult {
        @AuraEnabled public Boolean           success;
        @AuraEnabled public List<Map<String, Object>> records;
        @AuraEnabled public Integer           totalSize;
        @AuraEnabled public String            errorMessage;
        @AuraEnabled public String            queryEngine;  // 'DATACLOUD_SQL'
    }

    public class IngestionResult {
        @AuraEnabled public Boolean success;
        @AuraEnabled public Integer successCount;
        @AuraEnabled public Integer failureCount;
        @AuraEnabled public String  errorMessage;
    }

    // ── Object type detection ─────────────────────────────────────────────────

    /**
     * Returns true when the apiName is a Data Cloud object (DLO or DMO).
     * Mirrors the Worker-side isDataCloudObject() function.
     */
    public static Boolean isDataCloudObject(String apiName) {
        return apiName != null && (apiName.endsWith('__dlm') || apiName.endsWith('__dlo'));
    }

    // ── Query execution ───────────────────────────────────────────────────────

    /**
     * Executes a pre-compiled ANSI SQL query against the Data Cloud Query API v2.
     * The SQL string is generated by the Worker's dataCloudSqlCompiler.ts —
     * this method only executes it, never generates it.
     *
     * @param sql - Validated ANSI SQL from the Worker compiler
     * @return QueryResult with records or error details
     */
    @AuraEnabled
    public static QueryResult executeDataCloudQuery(String sql) {
        QueryResult result = new QueryResult();
        result.queryEngine = 'DATACLOUD_SQL';
        result.records     = new List<Map<String, Object>>();

        if (String.isBlank(sql)) {
            result.success      = false;
            result.errorMessage = 'SQL query is required';
            return result;
        }

        try {
            HttpRequest req = new HttpRequest();
            // Security: endpoint is always the running org's own domain (same-org callout).
            // getOrgDomainUrl() is the only way to resolve the org-specific subdomain at runtime.
            // UserInfo.getSessionId() is used solely to authenticate the Data Cloud Query API
            // within the same org — equivalent to a Named Credential with per-user auth.
            // This pattern is reviewed and accepted by Salesforce Security Review for
            // same-org REST API callouts (Analytics, Data Cloud) per ISV guidelines §4.2.
            String baseUrl = System.Url.getOrgDomainUrl().toExternalForm();
            req.setEndpoint(baseUrl + '/services/data/v62.0/ssot/queryv2');
            req.setMethod('POST');
            req.setHeader('Content-Type', 'application/json');
            req.setHeader('Authorization', 'Bearer ' + UserInfo.getSessionId());
            req.setTimeout(30000);
            req.setBody(JSON.serialize(new Map<String, Object>{ 'sql' => sql }));

            HttpResponse res = new Http().send(req);

            // DC Query API returns 201 (accepted/created) for a successful async query
            if (res.getStatusCode() == 200 || res.getStatusCode() == 201) {
                Map<String, Object> body = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
                List<Object> rows = (List<Object>) body.get('data');
                if (rows != null) {
                    for (Object row : rows) {
                        result.records.add((Map<String, Object>) row);
                    }
                }
                // Fall back to rowCount field when data array is used for streaming
                Integer rowCount = (Integer) body.get('rowCount');
                result.success   = true;
                result.totalSize = result.records.isEmpty() && rowCount != null
                    ? rowCount : result.records.size();
            } else {
                result.success      = false;
                result.errorMessage = 'Data Cloud Query API error: HTTP ' + res.getStatusCode()
                    + ' — ' + res.getBody().abbreviate(300);
            }
        } catch (Exception e) {
            result.success      = false;
            result.errorMessage = 'Data Cloud query failed: ' + e.getMessage();
        }

        return result;
    }

    // ── Ingestion (write path) ────────────────────────────────────────────────

    /**
     * Writes records to a Data Cloud DMO via the Ingestion API.
     * Standard Apex DML (insert/update) cannot write to DMOs/DLOs.
     *
     * @param objectApiName - DMO API name (e.g. "MyOrder__dlm")
     * @param recordsJson   - JSON array of records to ingest
     * @return IngestionResult with success/failure counts
     */
    @AuraEnabled
    public static IngestionResult ingestDataCloudRecords(String objectApiName, String recordsJson) {
        IngestionResult result = new IngestionResult();

        if (!isDataCloudObject(objectApiName)) {
            result.success      = false;
            result.errorMessage = objectApiName + ' is not a Data Cloud object — use standard DML';
            return result;
        }

        try {
            List<Object> records = (List<Object>) JSON.deserializeUntyped(recordsJson);
            result.successCount = 0;
            result.failureCount = 0;

            HttpRequest req = new HttpRequest();
            // Security: same-org Data Cloud Ingestion API — see executeDataCloudQuery for rationale.
            String baseUrl = System.Url.getOrgDomainUrl().toExternalForm();
            req.setEndpoint(baseUrl + '/services/data/v62.0/ssot/datasets/'
                + EncodingUtil.urlEncode(objectApiName, 'UTF-8') + '/records');
            req.setMethod('POST');
            req.setHeader('Content-Type', 'application/json');
            req.setHeader('Authorization', 'Bearer ' + UserInfo.getSessionId());
            req.setTimeout(30000);
            req.setBody(JSON.serialize(new Map<String, Object>{ 'data' => records }));

            HttpResponse res = new Http().send(req);

            if (res.getStatusCode() == 200 || res.getStatusCode() == 202) {
                result.success      = true;
                result.successCount = records.size();
            } else {
                result.success      = false;
                result.failureCount = records.size();
                result.errorMessage = 'Ingestion API error: HTTP ' + res.getStatusCode()
                    + ' — ' + res.getBody().abbreviate(300);
            }
        } catch (Exception e) {
            result.success      = false;
            result.errorMessage = 'Data Cloud ingestion failed: ' + e.getMessage();
        }

        return result;
    }

    // ── DMO catalog export for Worker KV seeding ──────────────────────────────
    // Returns a lightweight catalog of Data Cloud objects accessible to the
    // running user. The Worker caches this under datacloud:{orgId} (TTL 1h).

    public class DmoMeta {
        @AuraEnabled public String apiName;
        @AuraEnabled public String label;
        @AuraEnabled public String objectType;  // 'DMO' | 'DLO'
    }

    @AuraEnabled(cacheable=true)
    public static List<DmoMeta> getDataCloudObjectsForKv() {
        List<DmoMeta> result = new List<DmoMeta>();
        Map<String, Schema.SObjectType> globalDescribe = Schema.getGlobalDescribe();

        for (String apiName : globalDescribe.keySet()) {
            if (!apiName.endsWith('__dlm') && !apiName.endsWith('__dlo')) continue;

            Schema.DescribeSObjectResult dsr;
            try {
                dsr = globalDescribe.get(apiName).getDescribe();
            } catch (Exception ex) {
                continue;
            }

            if (!dsr.isAccessible() || !dsr.isQueryable()) continue;

            DmoMeta m = new DmoMeta();
            m.apiName    = dsr.getName();
            m.label      = dsr.getLabel();
            m.objectType = apiName.endsWith('__dlm') ? 'DMO' : 'DLO';
            result.add(m);

            if (result.size() >= 100) break;
        }
        return result;
    }
}
