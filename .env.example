# FlashBar AI — E2E Test Environment
# Copy to .env and fill in your values. Never commit .env.

# Full Lightning instance URL (no trailing slash)
SF_INSTANCE_URL=https://your-org.lightning.force.com

# The Lightning App URL where furuAgentBar is in the Utility Bar
SF_APP_URL=/lightning/app/standard__LightningInstrumentation

# ── Admin session (required) ──────────────────────────────────────────────────
# Access token for an admin user with FlashBar_Admin permission set.
# Obtained via: sf org display --target-org <alias> | grep "Access Token"
# Used to authenticate admin tests AND to build Login-As sessions for EN/JA users.
SF_ADMIN_ACCESS_TOKEN=00Dxx...

# ── Test user credentials (FlashBar_User permission set) ───────────────────────
# playwright.config.ts requires these four to be set (non-empty) before any spec
# runs. globalSetup.ts's EN/JA sessions are actually built via the admin token's
# "Login As" against two hardcoded User Ids (flashbar.test.en / flashbar.test.ja —
# see tests/e2e/setup/globalSetup.ts), not by logging in with these credentials
# directly. If you're pointing this suite at a different org, create matching
# EN/JA test users there and update those hardcoded Ids in globalSetup.ts.
SF_EN_USERNAME=flashbar.test.en@your-org.com
SF_EN_PASSWORD=changeme
SF_JA_USERNAME=flashbar.test.ja@your-org.com
SF_JA_PASSWORD=changeme

# (Optional) A record page URL for summary card and parent-child filter tests
# Must be an Account record that has at least one related Opportunity and Case
SF_RECORD_URL=/lightning/r/Account/001xx.../view

# (Optional) The exact Account Name at SF_RECORD_URL — used in parent-child filter tests
SF_ACCOUNT_NAME=Dickenson plc
