# Salesforce org credentials for E2E tests
# Copy this file to .env and fill in your values

# Full instance URL (no trailing slash): https://your-org.lightning.force.com
SF_INSTANCE_URL=https://your-org.lightning.force.com

# Salesforce login URL (usually https://login.salesforce.com or https://test.salesforce.com for sandboxes)
SF_LOGIN_URL=https://login.salesforce.com

# Test user credentials (use a dedicated test user, not an admin account)
SF_USERNAME=your-user@your-org.com
SF_PASSWORD=YourPassword123

# The Lightning App URL where furuAgentBar is in the Utility Bar
# Navigate there manually, copy the URL, paste here
SF_APP_URL=/lightning/app/standard__LightningInstrumentation

# (Optional) A record page URL that has the furuAgentBar utility bar
# Used for summary card tests
SF_RECORD_URL=/lightning/r/Opportunity/0064000000AbcDeAAA/view
